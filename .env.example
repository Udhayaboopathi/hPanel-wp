# Own hPanel - example environment. Copy to .env and fill in.
# NEVER commit a real .env. In production this file is written by the CI/CD
# deploy workflow from GitHub Secrets (chmod 600) - see docs/CICD.md.
# The only secret value in it is DB_ADMIN_PASSWORD (empty in this example).

# Public hostname for the panel itself (routed by the existing Traefik).
PANEL_DOMAIN=panel.example.com

# Public IPv4 of the server, shown in DNS instructions.
SERVER_IP=130.210.42.20

# --- Shared MariaDB (the ONE pre-existing DB server for everything) ---
# Own hPanel does NOT run its own MariaDB container. All WordPress sites
# and the panel itself use the pre-existing shared MariaDB container
# (default: construction-mariadb, MariaDB 11.4). The panel stack never
# creates/stops/restarts it.
DB_CONTAINER=construction-mariadb
# External/testing endpoint of that DB server.
DB_HOST=db.krwebsolution.com
DB_EXTERNAL_PORT=3024
# Common provisioning/admin account on the shared server.
DB_ADMIN_USER=WordPress_common_DB
# SECRET - leave empty here; supply via GitHub Secrets / server .env only.
DB_ADMIN_PASSWORD=
# Preferred alternative to the plain env var: a 0600 file with the password.
# DB_ADMIN_PASSWORD_FILE=/opt/own-hpanel/secrets/db_admin_password.txt

# --- Panel metadata store ---
# mysql  = panel metadata in the shared MariaDB (production)
# sqlite = local file in PANEL_DATA_DIR (local development default)
PANEL_STORE_DRIVER=mysql
# The panel's own database on the shared server.
PANEL_DB_NAME=hpanel_panel
# Optional full DSN override (needed if the DB password contains '@', '/'
# or '?', which are ambiguous in a DSN built from parts).
# PANEL_STORE_DSN=

# --- Panel process (defaults shown) ---
# PANEL_ADDR=:8080
# PANEL_DATA_DIR=/data
# PANEL_SECURE_COOKIES=true
# SITES_DIR=/opt/own-hpanel/websites
# BACKUPS_DIR=/opt/own-hpanel/backups
# AGENT_SOCKET=/run/own-hpanel/agent.sock
# AGENT_TOKEN_FILE=/opt/own-hpanel/secrets/agent.token

# --- Agent process (host systemd service) ---
# AGENT_SOCKET=/run/own-hpanel/agent.sock
# AGENT_TOKEN_FILE=/opt/own-hpanel/secrets/agent.token
# DB_ADMIN_PASSWORD_FILE=/opt/own-hpanel/secrets/db_admin_password.txt
# DOCKER_SOCKET=/var/run/docker.sock
