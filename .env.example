# Own hPanel - example environment. Copy to .env and fill in.
# NEVER commit a real .env. In production this file is written by the CI/CD
# deploy workflow from GitHub Secrets (chmod 600) - see docs/CICD.md.
# NOTE: this file contains NO password values at all. The deploy workflow
# deliberately never writes DB_ADMIN_PASSWORD into the compose .env (the
# password contains `$`, which Compose interpolation would corrupt) - it
# exists only in the 0600 secret file (see DB_ADMIN_PASSWORD_FILE below).

# Public hostname for the panel itself (routed by the existing Traefik).
PANEL_DOMAIN=panel.example.com

# Public IPv4 of the server, shown in DNS instructions.
SERVER_IP=130.210.42.20

# --- Dedicated MariaDB (the stack's OWN DB container) ---
# Own hPanel runs its OWN MariaDB container, defined completely in
# compose.yaml (service wordpress-mariadb, image mariadb:11.4, pulled and
# started by `docker compose up`). All WordPress sites and the panel
# itself store their data there. The pre-existing production
# construction-mariadb is NOT used by Own hPanel in any way.
DB_CONTAINER=wordpress-mariadb
# External/testing endpoint: wordpress-mariadb publishes
# ${DB_EXTERNAL_PORT}:3306 on the host (see compose.yaml ports:).
DB_HOST=db.krwebsolution.com
DB_EXTERNAL_PORT=3024
# Common provisioning/admin account ON wordpress-mariadb ONLY (created by
# the MariaDB entrypoint from the secret file; upgraded to full
# provisioning grants on this container by
# deployment/mariadb-init/01-grants.sh + the deploy ensure step).
DB_ADMIN_USER=WordPress_common_DB
# DB_ADMIN_PASSWORD is NOT set here: the value comes from GitHub Secrets
# and is written ONLY to the 0600 file below (referenced as a compose
# file secret and by DB_ADMIN_PASSWORD_FILE).
# DB_ADMIN_PASSWORD_FILE=/opt/own-hpanel/secrets/db_admin_password.txt
# The container's ROOT password is separate: generated on the server if
# missing and stored ONLY in /opt/own-hpanel/secrets/mariadb_root_password.txt
# (0600). It is never in Git, never in .env, never printed.

# --- Panel metadata store ---
# mysql  = panel metadata in the dedicated wordpress-mariadb (production)
# sqlite = local file in PANEL_DATA_DIR (local development default)
PANEL_STORE_DRIVER=mysql
# The panel's own database on wordpress-mariadb.
PANEL_DB_NAME=hpanel_panel
# Optional full DSN override (needed if the DB password contains '@', '/'
# or '?', which are ambiguous in a DSN built from parts).
# PANEL_STORE_DSN=

# --- Panel process (defaults shown) ---
# PANEL_ADDR=:8080
# PANEL_DATA_DIR=/data
# PANEL_SECURE_COOKIES=true
# SITES_DIR=/opt/own-hpanel/websites
# BACKUPS_DIR=/opt/own-hpanel/backups
# AGENT_SOCKET=/run/own-hpanel/agent.sock
# AGENT_TOKEN_FILE=/opt/own-hpanel/secrets/agent.token

# --- Agent process (host systemd service) ---
# AGENT_SOCKET=/run/own-hpanel/agent.sock
# AGENT_TOKEN_FILE=/opt/own-hpanel/secrets/agent.token
# DB_ADMIN_PASSWORD_FILE=/opt/own-hpanel/secrets/db_admin_password.txt
# DOCKER_SOCKET=/var/run/docker.sock
