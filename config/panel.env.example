# Reference copy of the panel environment - see ../.env.example
# No password values live in this file: the DB admin password is file-only
# (/opt/own-hpanel/secrets/db_admin_password.txt) and the MariaDB root
# password is server-generated into
# /opt/own-hpanel/secrets/mariadb_root_password.txt.
PANEL_DOMAIN=panel.example.com
SERVER_IP=130.210.42.20
DB_CONTAINER=wordpress-mariadb
DB_HOST=db.krwebsolution.com
DB_EXTERNAL_PORT=3024
DB_ADMIN_USER=WordPress_common_DB
PANEL_STORE_DRIVER=mysql
PANEL_DB_NAME=hpanel_panel
