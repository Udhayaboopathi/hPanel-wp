[Unit]
Description=Own hPanel provisioning agent (privileged, local socket only)
After=docker.service
Requires=docker.service

[Service]
Type=simple
ExecStart=/opt/own-hpanel/bin/agent
Environment=AGENT_SOCKET=/run/own-hpanel/agent.sock
Environment=AGENT_TOKEN_FILE=/opt/own-hpanel/secrets/agent.token
# Dedicated MariaDB of the hPanel stack (wordpress-mariadb, defined in
# compose.yaml): the agent connects as the common admin user, execs the
# SQL client in that container only, and connects it to per-site networks.
# Password comes from a 0600 file, never from a unit literal. DB_* values
# may be overridden via a systemd drop-in or the EnvironmentFile below
# (written by CI from GitHub Secrets).
Environment=DB_CONTAINER=wordpress-mariadb
Environment=DB_HOST=db.krwebsolution.com
Environment=DB_EXTERNAL_PORT=3024
Environment=DB_ADMIN_USER=WordPress_common_DB
Environment=DB_ADMIN_PASSWORD_FILE=/opt/own-hpanel/secrets/db_admin_password.txt
Environment=DOCKER_SOCKET=/var/run/docker.sock
Environment=SITES_DIR=/opt/own-hpanel/websites
Environment=BACKUPS_DIR=/opt/own-hpanel/backups
RuntimeDirectory=own-hpanel
RuntimeDirectoryMode=0755
Restart=on-failure
RestartSec=3
# The agent is host-privileged by necessity (Docker access). It is confined
# as far as systemd allows without breaking Docker socket access, listens
# only on a Unix socket, and validates an allowlist of operations.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/own-hpanel /run/own-hpanel
PrivateTmp=true

[Install]
WantedBy=multi-user.target
